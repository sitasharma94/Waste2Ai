# Copy this file to .env and fill in real values. Never commit .env.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=

# The EXISTING Waste2Value application database (the same one Modules 1-3 use).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waste2value_admin_test

# Folder where the main app (Module 2) saves listing images. Optional: defaults
# to ../main_app/static/uploads. The admin app only reads from it.
# MAIN_UPLOAD_FOLDER=

# Admin Dashboard server (separate from the main app on port 5000).
ADMIN_HOST=127.0.0.1
ADMIN_PORT=5001
ADMIN_DEBUG=0

# Session lifetime in minutes, and whether the cookie requires HTTPS.
ADMIN_SESSION_MINUTES=120
ADMIN_COOKIE_SECURE=0
