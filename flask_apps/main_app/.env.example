DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waste2value_final

# Razorpay (online payments). Leave blank to keep online payments disabled;
# Cash on Delivery and free items work without them. Never commit real values.
# Use rzp_test_ keys from Dashboard > Account & Settings > API Keys while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when adding the webhook in Dashboard > Webhooks (optional).
RAZORPAY_WEBHOOK_SECRET=
# 'Demo Payment (simulation only)' checkout option: on by default ONLY while the
# Razorpay keys above are blank. It never moves money and is never recorded as paid.
# Set to 0 to hide it, 1 to force it on.
DIY_PAYMENT_SIMULATION=

# Signs login sessions. Set a long random value for any real deployment.
SECRET_KEY=
